# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
APP_NAME=MLA-Grievance-System

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mla_grievance?retryWrites=true&w=majority

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
OTP_EXPIRY_MINUTES=5
PIN_SALT_ROUNDS=10

# ============================================
# CLOUDINARY (Free Tier)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# TWILIO (OTP via SMS)
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ============================================
# REDIS (Optional — for future scaling)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
