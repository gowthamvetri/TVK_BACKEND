# ============================================
# MLA-Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# SECURITY: Never commit .env file to version control
#
# For Docker Deployment:
#   - Copy this file to .env
#   - Fill in all required values
#   - Run: docker-compose up -d

# ============================================
# APPLICATION
# ============================================
# NODE_ENV: development | production | test
# Set to 'production' when deploying with Docker
NODE_ENV=production
PORT=5000
API_VERSION=v1
APP_NAME=MLA-Grievance-System

# ============================================
# DATABASE - MONGODB
# ============================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
# SECURITY: Use MongoDB Atlas (cloud) for production
# Local dev: mongodb://localhost:27017/mla_grievance
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mla_grievance?retryWrites=true&w=majority

# ============================================
# JWT & AUTHENTICATION
# ============================================
# SECURITY: Generate strong secrets with: 
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Requirements:
#   - Minimum 32 characters
#   - Random and unique
#   - Different for each secret in production
JWT_ACCESS_SECRET=your_access_token_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_here_min_32_chars
JWT_REGISTRATION_SECRET=your_registration_secret_here_min_32_chars
JWT_RESET_SECRET=your_reset_token_secret_here_min_32_chars

# Token validity periods
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REGISTRATION_EXPIRY=15m
JWT_RESET_EXPIRY=15m

# OTP & PIN Configuration
OTP_EXPIRY_MINUTES=5
PIN_SALT_ROUNDS=10

# ============================================
# CLOUDINARY - FILE UPLOADS
# ============================================
# Sign up: https://cloudinary.com (free tier available)
# API Keys: https://console.cloudinary.com/settings/api-keys
# Documentation: https://cloudinary.com/documentation/node_integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# TWILIO - SMS NOTIFICATIONS
# ============================================
# Sign up: https://www.twilio.com
# API Credentials: https://console.twilio.com
# Number Format: +1234567890 (with country code)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ============================================
# REDIS - CACHING LAYER
# ============================================
# Format: redis://[:password]@host:port/db
# Local development: redis://localhost:6379
# Cloud services: Redis Cloud, Upstash, ElastiCache, etc.
# Disabled if REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# Connection resilience settings (milliseconds)
REDIS_MAX_RETRIES=5
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# Cache TTL settings (in seconds)
REDIS_TTL_SHORT=300        # 5 minutes - volatile data
REDIS_TTL_MEDIUM=3600      # 1 hour - moderate data
REDIS_TTL_LONG=86400       # 24 hours - static data
REDIS_TTL_USER=1800        # 30 minutes - user session data
REDIS_TTL_COMPLAINT=600    # 10 minutes - complaint listings
REDIS_TTL_LIST=300         # 5 minutes - general list responses

# ============================================
# RATE LIMITING
# ============================================
# Window: time period in milliseconds (900000 = 15 minutes)
# Max requests allowed per IP per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# ============================================
# CORS - CROSS-ORIGIN REQUESTS
# ============================================
# Development: * (allow all)
# Production: comma-separated list of allowed origins
# Example: https://app.example.com,https://web.example.com
CORS_ORIGIN=*

# ============================================
# LOGGING
# ============================================
# Log levels: error, warn, info, debug
# Production: info or warn (less verbose)
# Development: debug (more detailed)
LOG_LEVEL=info

# ============================================
# DOCKER DEPLOYMENT NOTES
# ============================================
# When deploying with Docker:
#
# 1. Build image: docker-compose build
# 2. Start services: docker-compose up -d
# 3. View logs: docker-compose logs -f app
# 4. Stop services: docker-compose down
#
# Health checks:
#   - Basic: http://localhost:5000/health
#   - Detailed: http://localhost:5000/health/detailed
#   - API Docs: http://localhost:5000/api-docs
#
# Database setup:
#   - Ensure MongoDB is accessible from container
#   - Test connection: docker-compose exec app node -e "require('mongoose').connect(process.env.MONGODB_URI)"
#
# Volume persistence:
#   - /app/uploads: User-uploaded files (images, documents)
#   - /app/logs: Application logs
#   - Both are mounted to local ./uploads and ./logs directories
